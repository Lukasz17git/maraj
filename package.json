{
   "name": "maraj",
   "version": "2.11.0",
   "description": "A lightweight 600 bytes gzipped alternative for immutable updates while dealing with objects and arrays",
   "keywords": [
      "shallow",
      "shallow copy",
      "nested copy"
   ],
   "author": "Lukasz Maraj",
   "license": "MIT",
   "private": false,
   "main": "dist/index.js",
   "module": "dist/index.mjs",
   "types": "dist/index.d.ts",
   "files": [
      "dist",
      "README.md",
      "LICENSE"
   ],
   "scripts": {
      "dev": "vitest",
      "test": "vitest run",
      "build": "tsdown",
      "lint": "tsc",
      "trace": "tsc --generateTrace trace",
      "ci": "npm run lint && npm run test && npm run build",
      "release": "node scripts/check-changelog.mjs && npm run build && changeset publish"
   },
   "repository": {
      "type": "git",
      "url": "git+https://github.com/Lukasz17git/maraj.git"
   },
   "bugs": {
      "url": "https://github.com/Lukasz17git/maraj/issues"
   },
   "homepage": "https://github.com/Lukasz17git/maraj#readme",
   "devDependencies": {
      "@changesets/cli": "^3.0.3",
      "@microsoft/api-extractor": "^7.59.4",
      "@typescript/analyze-trace": "^0.11.1",
      "tsdown": "^0.23.1",
      "typescript": "^7.0.2",
      "vitest": "^5.0.5"
   }
}
